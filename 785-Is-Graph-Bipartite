class Solution {
public:
     bool bfs(vector<int> &vis,int u,vector<vector<int>> &graph){
        int n = graph.size();
        int m = graph.size();
        queue<pair<int,int>> q;
        q.push({u,0});
        vis[u]=0;
        while(!q.empty()){
            int i = q.front().first;
            int c = q.front().second;
            q.pop();
            for(auto &v:graph[i]){
                if(vis[v]==-1){
                    if(c==0){
                        q.push({v,1});  //or 1-c
                        vis[v]=1;
                    }else{
                        q.push({v,0});
                        vis[v]=0;
                    }
                }else if(vis[v]==c){
                    return false;
                }
            }

        }
        return true;
    }
    bool isBipartite(vector<vector<int>>& graph) {
        int n = graph.size();
        vector<int> vis(n,-1);
        for(int i=0;i<n;i++){
                if(vis[i]==-1){
                    if(!bfs(vis,i,graph)){
                        return false;
                    }
                }
        }
        return true;
    }
};